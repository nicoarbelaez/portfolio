---
/**
 * <Architecture> MDX block. Validates props with Zod (build fails on invalid input) and renders
 * the React island `ArchitectureView` with `client:visible`: the HTML is server-rendered and
 * readable without JS; animation starts after hydration, when the block is on screen.
 */
import { ArchitectureView } from './views/ArchitectureView';
import { architectureSchema } from './schemas/doc-block-schemas';
import { parseDocBlockProps } from './utils/parse-doc-block-props';

const props = parseDocBlockProps('Architecture', architectureSchema, Astro.props);
---

<ArchitectureView client:visible {...props} />
