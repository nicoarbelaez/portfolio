---
/**
 * <StackGrid> MDX block. Validates props with Zod (build fails on invalid input) and renders
 * the React island `StackGridView` with `client:visible`: the HTML is server-rendered and
 * readable without JS; animation starts after hydration, when the block is on screen.
 */
import { StackGridView } from './views/StackGridView';
import { stackGridSchema } from './schemas/doc-block-schemas';
import { parseDocBlockProps } from './utils/parse-doc-block-props';

const props = parseDocBlockProps('StackGrid', stackGridSchema, Astro.props);
---

<StackGridView client:visible {...props} />
