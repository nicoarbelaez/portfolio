---
import { HeroContent } from '@/components/sections/HeroContent';
import { SocialDock } from '@/components/sections/SocialDock';
import { heroProfessionalSegments } from '@/i18n/hero-professional';
import { locales } from '@/i18n/ui';
import { useTranslations } from '@/i18n/utils';

interface Props {
  lang: keyof typeof locales;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

/** Pre-optimized (256x256, ~16KB) — served as-is from public/, no astro:assets/sharp needed. */
const AVATAR_SRC = '/img/profile/avatar.jpg';
---

<section id="about" aria-labelledby="hero-heading" class="w-full scroll-mt-24">
  <HeroContent
    client:load
    avatarSrc={AVATAR_SRC}
    greeting={t('hero.greeting')}
    professionalDesktop={heroProfessionalSegments[lang].desktop}
    professionalMobile={heroProfessionalSegments[lang].mobile}
    description={t('hero.description')}
    avatarAlt={t('hero.avatarAlt')}
    resumeLabel={t('hero.resume')}
  />
  <SocialDock client:visible label={t('social.nav')} />
</section>
