---
import ProjectDetailPage from '@/features/projects/components/ProjectDetailPage.astro';
import { getActiveProjectSlugs } from '@/features/projects/services/projects';

export async function getStaticPaths() {
  const slugs = await getActiveProjectSlugs();
  return slugs.map((slug) => ({ params: { slug } }));
}

const slug = Astro.params.slug;
if (!slug) {
  return Astro.redirect('/');
}
---

<ProjectDetailPage lang="en" slug={slug} />
