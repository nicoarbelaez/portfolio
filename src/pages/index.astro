---
import Layout from '@/layouts/Layout.astro';
import { getCurrentLang, useTranslations } from '@/i18n/utils';

const lang = getCurrentLang(Astro.currentLocale);
const t = useTranslations(lang);
---

<Layout lang={lang} title={t('title')} description={t('schema.description')}>
  <main id="main" class="mx-auto max-w-3xl px-4 pt-28 pb-16">
    <h1 class="font-heading text-3xl font-bold tracking-tight sm:text-4xl">Hello World</h1>
  </main>
</Layout>
