---
import ProjectsIntro from '@/features/projects/components/ProjectsIntro.astro';
import { ProjectShowcaseBlock } from '@/features/projects/components/ProjectShowcaseBlock';
import { ProjectsTabs } from '@/features/projects/components/ProjectsTabs';
import { enrichProjects, groupProjectsBySection } from '@/features/projects/services/enrich';
import { HOME_SECTION_STACK_CLASS } from '@/constants/home-layout';
import { NAV_SECTION_SCROLL_MARGIN_CLASS } from '@/features/nav/constants/sections';
import type { LocaleKey } from '@/i18n/ui';
import { useTranslations } from '@/i18n/utils';

interface Props {
  lang: LocaleKey;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const projects = await enrichProjects(lang);
const groups = groupProjectsBySection(projects);

const hasProjects = groups.client.length > 0 || groups.side.length > 0;
const hasApps = groups.apps.length > 0;

const cardLabels = {
  site: t('projects.cta.site'),
  repo: t('projects.cta.repo'),
  details: t('projects.cta.details'),
  present: t('projects.timeline.present')
};
const sectionClass = ['w-full', HOME_SECTION_STACK_CLASS, NAV_SECTION_SCROLL_MARGIN_CLASS];
---

{/*
  `contents` so projects + apps participate in HomePage flex gap
  (same distance as experience / about).
  Order: intro → tabs [client showcases | side cards] (#projects), then apps (#apps).
*/}
<div class="contents">
  {hasProjects ? (
    <section id="projects" aria-label={t('projects.nav')} class:list={sectionClass}>
      <ProjectsIntro
        badge={t('projects.nav')}
        headline={t('projects.headline')}
        subtext={t('projects.subtext')}
      />
      <ProjectsTabs
        client:visible
        lang={lang}
        groups={{ client: groups.client, side: groups.side }}
        labels={{
          client: t('projects.section.client'),
          side: t('projects.section.side'),
          card: cardLabels
        }}
      />
    </section>
  ) : null}
  {hasApps ? (
    <section id="apps" aria-label={t('projects.section.apps')} class:list={sectionClass}>
      <ProjectShowcaseBlock
        client:visible
        lang={lang}
        label={t('projects.section.apps')}
        projects={groups.apps}
        cardLabels={cardLabels}
      />
    </section>
  ) : null}
</div>
