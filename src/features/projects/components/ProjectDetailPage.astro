---
import { render } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import { buttonVariants } from '@/components/ui/button';
import { DOC_BLOCK_COMPONENTS } from '@/components/doc-blocks/mdx-components';
import { PERSONAL_INFO } from '@/constants/constants';
import { ProjectMark } from '@/features/projects/clients/shared/components/ClientMark';
import ProjectDetailMeta from '@/features/projects/components/ProjectDetailMeta.astro';
import { ProjectDetailTabs } from '@/features/projects/components/ProjectDetailTabs';
import { ProjectCtasLinks } from '@/features/projects/components/ProjectCtas';
import {
  projectImageTransitionName,
  projectTitleTransitionName
} from '@/features/projects/constants/view-transitions';
import { buildProjectJsonLd } from '@/features/projects/services/json-ld';
import { getProjectBySlug, getProjectDoc } from '@/features/projects/services/projects';
import type { LocaleKey } from '@/i18n/ui';
import { useTranslations, getLocalizedPath } from '@/i18n/utils';
import { cn } from '@/lib/utils';

interface Props {
  lang: LocaleKey;
  slug: string;
}

const { lang, slug } = Astro.props;
const t = useTranslations(lang);
const project = await getProjectBySlug(slug, lang);

if (!project) {
  return Astro.redirect('/404');
}

const [overviewDoc, technicalDoc] = await Promise.all([
  getProjectDoc(slug, 'overview', lang),
  getProjectDoc(slug, 'technical', lang)
]);
const OverviewContent = overviewDoc ? (await render(overviewDoc.entry)).Content : null;
const TechnicalContent = technicalDoc ? (await render(technicalDoc.entry)).Content : null;

const projectsHref = `${getLocalizedPath('/', lang)}#projects`;
const imageVtName = projectImageTransitionName(project.slug);
const titleVtName = projectTitleTransitionName(project.slug);
const ogImagePath = `/og/${lang}/${project.slug}.png`;
const jsonLd = buildProjectJsonLd({
  project,
  lang,
  url: Astro.url.href,
  image: new URL(ogImagePath, Astro.url).href,
  authorName: PERSONAL_INFO.FULL_NAME
});
---

<Layout
  lang={lang}
  title={`${project.title} · ${t('title')}`}
  description={project.description}
  image={ogImagePath}
  type="article"
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <main id="main" class="mx-auto w-full max-w-3xl px-4 pt-24 pb-20">
    <a
      href={projectsHref}
      class={cn(
        buttonVariants({ variant: 'ghost', size: 'sm' }),
        'text-muted-foreground -ml-2 mb-8'
      )}
    >
      ← {t('projects.back')}
    </a>

    <article class="space-y-10">
      <header class="border-border/70 space-y-5 border-b pb-8">
        <div class="flex items-center gap-3">
          <ProjectMark slug={project.slug} size="lg" />
          <p class="text-muted-foreground text-xs font-medium tracking-[0.18em] uppercase">
            {t(`projects.section.${project.section}`)}
          </p>
        </div>
        <h1
          class="font-heading text-3xl font-semibold tracking-tight text-balance md:text-4xl"
          transition:name={titleVtName}
        >
          {project.title}
        </h1>
        <p class="text-muted-foreground max-w-2xl text-base leading-relaxed text-pretty md:text-lg">
          {project.tagline}
        </p>

        {project.topics.length > 0 ? (
          <ul class="flex flex-wrap gap-1.5 pt-1" aria-label={t('projects.topics')}>
            {project.topics.map((topic) => (
              <li class="border-border bg-background text-muted-foreground rounded-full border px-2.5 py-0.5 text-xs">
                {topic}
              </li>
            ))}
          </ul>
        ) : null}

        <ProjectCtasLinks
          client:load
          ctas={project.ctas}
          labels={{
            site: t('projects.cta.site'),
            repo: t('projects.cta.repo'),
            details: t('projects.cta.details')
          }}
        />
      </header>

      {project.cover ? (
        <figure
          class="border-border overflow-hidden rounded-xl border"
          transition:name={imageVtName}
        >
          <img
            src={project.cover.src}
            width={project.cover.width}
            height={project.cover.height}
            alt=""
            class="aspect-[16/9] w-full object-cover"
            loading="eager"
          />
        </figure>
      ) : (
        <div
          class="from-muted via-background to-secondary/15 border-border flex aspect-[16/9] w-full items-center justify-center rounded-xl border bg-gradient-to-br"
          transition:name={imageVtName}
        >
          <span class="text-muted-foreground font-heading text-sm tracking-wide">
            {project.title}
          </span>
        </div>
      )}

      <ProjectDetailMeta project={project} lang={lang} />

      <ProjectDetailTabs
        client:visible
        overviewMissingTranslation={Boolean(overviewDoc?.missingTranslation)}
        technicalMissingTranslation={Boolean(technicalDoc?.missingTranslation)}
        labels={{
          overview: t('projects.tab.overview'),
          technical: t('projects.tab.technical'),
          missingTranslation: t('projects.badge.missingTranslation'),
          emptyOverview: t('projects.empty.overview')
        }}
      >
        {OverviewContent ? (
          <OverviewContent slot="overview" components={DOC_BLOCK_COMPONENTS} />
        ) : null}
        {TechnicalContent ? (
          <TechnicalContent slot="technical" components={DOC_BLOCK_COMPONENTS} />
        ) : null}
      </ProjectDetailTabs>
    </article>
  </main>
</Layout>
