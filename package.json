{
  "name": "portfolio",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "concurrently \"astro dev\" \"pnpm dev:resume\" \"pnpm dev:resume-hash\"",
    "dev:resume": "python -m rendercv render ./resume/cv.yaml --watch --dont-generate-markdown --dont-generate-html --dont-generate-png --output-folder ./.tmp/rendercv --pdf-path ./resume.pdf",
    "dev:resume-hash": "node ./resume/scripts/hash-resume.mjs && chokidar \"resume/cv.yaml\" \"resume/resume.pdf\" -c \"node ./resume/scripts/hash-resume.mjs\"",
    "build": "pnpm generate:resume && astro build",
    "generate:resume": "node ./resume/scripts/generate-resume.mjs",
    "optimize:assets": "node ./scripts/optimize-assets.mjs && node ./scripts/apply-optimized-assets.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,astro}\"",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint --cache-strategy content",
    "lint:fix": "eslint . --fix --cache --cache-location node_modules/.cache/eslint --cache-strategy content",
    "typecheck": "astro check",
    "check": "pnpm lint && pnpm typecheck",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.6",
    "@astrojs/react": "^7.1.9",
    "@astrojs/sitemap": "^3.7.6",
    "@astrojs/vercel": "^11.0.22",
    "@base-ui-components/react": "1.0.0-rc.0",
    "@base-ui/react": "^1.9.0",
    "@js-temporal/polyfill": "^0.5.1",
    "@radix-ui/react-icons": "^1.3.2",
    "@remixicon/react": "^4.9.0",
    "@tailwindcss/vite": "^4.3.5",
    "@vercel/og": "^0.11.1",
    "astro": "^7.4.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-auto-height": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.81.0",
    "motion": "^14.14.0",
    "next-themes": "^0.4.6",
    "qr-code-styling": "^1.9.2",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-pretty-code": "^0.14.6",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "rough-notation": "^0.5.1",
    "shadcn": "^4.23.1",
    "shiki": "^4.6.0",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/ts-plugin": "^1.11.0",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^9.39.5",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "astro-eslint-parser": "^3.2.0",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^10.0.7",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^3.2.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,astro}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
