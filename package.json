{
  "name": "portfolio",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "concurrently \"astro dev\" \"pnpm dev:resume\" \"pnpm dev:resume-hash\"",
    "dev:resume": "python -m rendercv render ./resume/cv.yaml --watch --dont-generate-markdown --dont-generate-html --dont-generate-png --output-folder ./.tmp/rendercv --pdf-path ./resume.pdf",
    "dev:resume-hash": "node ./resume/scripts/hash-resume.mjs && chokidar \"resume/cv.yaml\" \"resume/resume.pdf\" -c \"node ./resume/scripts/hash-resume.mjs\"",
    "build": "pnpm generate:resume && astro build",
    "generate:resume": "node ./resume/scripts/generate-resume.mjs",
    "optimize:assets": "node ./scripts/optimize-assets.mjs && node ./scripts/apply-optimized-assets.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,astro}\"",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint --cache-strategy content",
    "lint:fix": "eslint . --fix --cache --cache-location node_modules/.cache/eslint --cache-strategy content",
    "typecheck": "astro check",
    "check": "pnpm lint && pnpm typecheck",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/react": "^5.0.5",
    "@astrojs/sitemap": "^3.7.2",
    "@astrojs/vercel": "^10.0.7",
    "@base-ui-components/react": "1.0.0-rc.0",
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/onest": "^5.2.8",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@js-temporal/polyfill": "^0.5.1",
    "@radix-ui/react-icons": "^1.3.2",
    "@remixicon/react": "^4.9.0",
    "@tailwindcss/vite": "^4.1.6",
    "@vercel/og": "^0.11.1",
    "astro": "^6.3.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.27.0",
    "motion": "^12.43.0",
    "next-themes": "^0.4.6",
    "qr-code-styling": "^1.9.2",
    "radix-ui": "^1.6.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "rehype-pretty-code": "^0.14.5",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "rough-notation": "^0.5.1",
    "shadcn": "^4.16.0",
    "shiki": "^4.3.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.6",
    "tw-animate-css": "^1.4.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/ts-plugin": "^1.10.10",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/js": "^9.18.0",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "astro-eslint-parser": "^3.0.0",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.18.0",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.1",
    "prettier": "^3.5.3",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,astro}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
